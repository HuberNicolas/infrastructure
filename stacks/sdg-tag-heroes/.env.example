# Environment variables of the sdg-tag-heroes stack. Set them in Coolify (resource → Environment Variables).
# Passwords and the JWT secret are generated by Coolify (SERVICE_PASSWORD_*, SERVICE_BASE64_*), not set here.

# Aurora for the thesis dataset, Dvdblk for the dummy dataset
PREDICTION_MODEL=Dvdblk

# Parts the overview map is split into; 1000 for the thesis dataset, 3 for the dummy dataset
MAP_PARTITIONS=3

# Optional GPT assistant (explanations, summaries, evaluations). Leave empty on a public server: every visitor
# could spend the key's credit
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Image tag to deploy; pin a source commit (sha-1a2b3c4) to roll back
IMAGE_TAG=latest
