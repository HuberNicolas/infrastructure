{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete*)",
      "Edit(**/.github/workflows/**)",
      "Write(**/.github/workflows/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /etc/claude-code/hooks/git_guard.py"
          }
        ]
      }
    ]
  }
}
